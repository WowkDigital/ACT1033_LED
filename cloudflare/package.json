{
  "name": "act1033-led-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "wrangler dev -c wrangler.local.jsonc",
    "deploy": "wrangler deploy -c wrangler.local.jsonc",
    "migrate": "wrangler d1 migrations apply act1033-led --remote -c wrangler.local.jsonc",
    "test": "node --test --disable-warning=ExperimentalWarning test/render.test.ts test/panels.test.ts test/mpk.test.ts test/board.test.ts",
    "check": "tsc --noEmit",
    "types": "wrangler types"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "typescript": "^5.6.0",
    "@cloudflare/workers-types": "^5.20261104.1"
  }
}
